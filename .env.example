# Neon: copy the *pooled* connection string from the Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only Google accounts on these domains can sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=taxace.com

# Optional: extra individual emails allowed regardless of domain (comma-separated)
ALLOWED_EMAILS=

# Local dev only. On Vercel, AUTH_TRUST_HOST is handled automatically.
# AUTH_URL=http://localhost:3000