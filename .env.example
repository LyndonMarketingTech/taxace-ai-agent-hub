# Neon: copy the *pooled* connection string from the Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Accounts can only be created for these email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=taxace.com

# Local dev only. On Vercel, AUTH_TRUST_HOST is handled automatically.
# AUTH_URL=http://localhost:3000